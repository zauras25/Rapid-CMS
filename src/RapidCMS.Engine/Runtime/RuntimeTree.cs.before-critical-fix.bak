using RapidCMS.Domain.Identity;
using RapidCMS.Domain.Nodes;

namespace RapidCMS.Engine.Runtime;

public sealed class RuntimeTree
{
    public RuntimeNode Root { get; }

    private RuntimeTree(RuntimeNode root)
    {
        Root = root ?? throw new ArgumentNullException(nameof(root));
    }

    public static RuntimeTree From(
        Node root,
        IReadOnlyDictionary<NodeId, Node> nodes)
    {
        ArgumentNullException.ThrowIfNull(root);
        ArgumentNullException.ThrowIfNull(nodes);

        if (root.Id.Value == Guid.Empty)
            throw new InvalidOperationException(
                "Runtime tree root cannot have an empty ID.");

        var visiting = new HashSet<NodeId>();
        var visited = new HashSet<NodeId>();

        var runtimeRoot = BuildNode(
            root,
            nodes,
            visiting,
            visited);

        return new RuntimeTree(runtimeRoot);
    }

    private static RuntimeNode BuildNode(
        Node node,
        IReadOnlyDictionary<NodeId, Node> nodes,
        HashSet<NodeId> visiting,
        HashSet<NodeId> visited)
    {
        if (node.Id.Value == Guid.Empty)
            throw new InvalidOperationException(
                "Node cannot have an empty ID.");

        // Detect a cycle in the currently active recursion path.
        if (!visiting.Add(node.Id))
        {
            throw new InvalidOperationException(
                $"Cycle detected in runtime tree at node '{node.Id}'.");
        }

        // A node appearing twice means the persisted graph is not a tree.
        if (!visited.Add(node.Id))
        {
            visiting.Remove(node.Id);

            throw new InvalidOperationException(
                $"Node '{node.Id}' appears more than once in the runtime tree.");
        }

        var runtimeNode = RuntimeNode.From(node);

        foreach (var childId in node.Children)
        {
            if (childId.Value == Guid.Empty)
            {
                throw new InvalidOperationException(
                    $"Node '{node.Id}' contains an empty child node ID.");
            }

            if (!nodes.TryGetValue(childId, out var child))
            {
                throw new InvalidOperationException(
                    $"Child node '{childId}' referenced by node '{node.Id}' was not found.");
            }

            if (child.ParentId != node.Id)
            {
                throw new InvalidOperationException(
                    $"Node '{child.Id}' claims parent '{child.ParentId}', " +
                    $"but node '{node.Id}' references it as a child.");
            }

            runtimeNode.AddChild(
                BuildNode(
                    child,
                    nodes,
                    visiting,
                    visited));
        }

        visiting.Remove(node.Id);

        return runtimeNode;
    }
}
